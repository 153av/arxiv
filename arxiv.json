{
  "openapi": "3.1.0",
  "info": {
    "title": "arXiv API",
    "description": "搜索 arXiv 上的学术论文",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://export.arxiv.org/api"
    }
  ],
  "paths": {
    "/query": {
      "get": {
        "summary": "搜索论文",
        "operationId": "arxiv_search",
        "parameters": [
          {
            "name": "search_query",
            "in": "query",
            "description": "搜索关键词，例如: 'machine learning' 或 'all:physics'",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start",
            "in": "query",
            "description": "分页起始位置",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "max_results",
            "in": "query",
            "description": "返回结果数量",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 5
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}
